<%- include('./partials/header') %>

<article class="booking-page">
    <header class="route-header">
        <div class="route-header-content">
            <h1 class="route-name">Bookings Administration</h1>
            <p>
                View all customer bookings across the Kizuna Rail network.
            </p>
        </div>
    </header>

    <section class="bookings-catalog">
        <select id="ticket-class-options" hidden>
            <% ticketClasses.forEach((ticketClass) => { %>
                <option value="<%= ticketClass.class %>"><%= ticketClass.name %></option>
            <% }); %>
        </select>

        <div id="schedule-day-options" hidden>
            <% schedules.forEach((schedule) => { %>
                <select data-schedule-id="<%= schedule.id %>">
                    <% (schedule.daysOfWeek || []).forEach((day) => { %>
                        <option value="<%= day %>"><%= day %></option>
                    <% }); %>
                </select>
            <% }); %>
        </div>

        <form id="booking-filters" class="booking-filters">
            <label>
                Booking ID
                <input
                    type="search"
                    name="q"
                    placeholder="Enter booking ID prefix"
                    maxlength="100"
                >
            </label>

            <label>
                Ticket class
                <select name="ticketClass">
                    <option value="">All ticket classes</option>
                    <% ticketClasses.forEach((ticketClass) => { %>
                        <option value="<%= ticketClass.class %>">
                            <%= ticketClass.name %>
                        </option>
                    <% }); %>
                </select>
            </label>

            <label>
                Trip ID
                <input
                    type="text"
                    name="tripId"
                    placeholder="Enter exact trip ID"
                >
            </label>

            <button type="submit">Search bookings</button>
            <button type="reset" id="clear-booking-filters">Clear filters</button>
        </form>

        <div class="bookings-state" id="bookings-loading">
            Loading bookings...
        </div>

        <div class="bookings-state bookings-error" id="bookings-error" hidden></div>

        <div class="bookings-grid" id="bookings-list"></div>

        <nav class="bookings-pagination" aria-label="Bookings pagination">
            <button type="button" id="previous-page" disabled>Previous</button>
            <span id="page-info" aria-live="polite">Page 1 of 1</span>
            <button type="button" id="next-page" disabled>Next</button>
        </nav>

        <template id="booking-card-template">
            <article class="booking-card" data-booking-id="">
                <header class="booking-card-header">
                    <h3 data-field="id"></h3>
                    <span data-field="ticketClass"></span>
                </header>

                <div class="booking-details">
                    <p>Trip ID: <span data-field="tripId"></span></p>
                    <p>Schedule ID: <span data-field="scheduleId"></span></p>
                    <p>Travel Day: <span data-field="selectedDay"></span></p>
                    <p>Passengers: <span data-field="passengerCount"></span></p>
                    <p>Created: <span data-field="createdAt"></span></p>
                </div>

                <button type="button" data-action="edit">Edit</button>
                <button type="button" data-action="delete">Delete</button>
            </article>
        </template>

        <template id="booking-edit-template">
            <header class="booking-edit-header">
                <h2 data-field="edit-title"></h2>
            </header>
            <form class="booking-edit-form" data-booking-id="">
                <label>
                    Ticket class
                    <input name="ticketClass" required>
                </label>

                <label>
                    Travel day
                    <input name="selectedDay" required>
                </label>

                <button type="submit">Save</button>
                <button type="button" data-action="cancel">Cancel</button>
            </form>
        </template>

        <p id="bookings-message" role="status"></p>
    </section>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const bookingsList = document.getElementById('bookings-list');
            const loadingElement = document.getElementById('bookings-loading');
            const errorElement = document.getElementById('bookings-error');
            const messageElement = document.getElementById('bookings-message');
            const cardTemplate = document.getElementById('booking-card-template');
            const editTemplate = document.getElementById('booking-edit-template');
            const previousPageButton = document.getElementById('previous-page');
            const nextPageButton = document.getElementById('next-page');
            const pageInfo = document.getElementById('page-info');
            const bookingFilters = document.getElementById('booking-filters');

            let bookingsById = new Map();
            let currentPage = 1;
            let totalPages = 0;
            const pageLimit = 10;
            let isLoadingBookings = false;

            function renderBookings() {
                const fragment = document.createDocumentFragment();

                for (const booking of bookingsById.values()) {
                    const card = cardTemplate.content.cloneNode(true);
                    const article = card.querySelector('[data-booking-id]');

                    article.dataset.bookingId = booking.id;
                    card.querySelector('[data-field="id"]').textContent =
                        `Booking ID: ${booking.id}`;
                    card.querySelector('[data-field="ticketClass"]').textContent =
                        `Ticket Class: ${booking.ticketClass}`;
                    card.querySelector('[data-field="tripId"]').textContent =
                        booking.tripId;
                    card.querySelector('[data-field="scheduleId"]').textContent =
                        booking.scheduleId;
                    card.querySelector('[data-field="selectedDay"]').textContent =
                        booking.selectedDay;
                    card.querySelector('[data-field="passengerCount"]').textContent =
                        booking.passengers?.length || 0;
                    card.querySelector('[data-field="createdAt"]').textContent =
                        booking.createdAt
                            ? new Date(booking.createdAt).toLocaleDateString()
                            : 'N/A';

                    fragment.append(card);
                }

                bookingsList.replaceChildren(fragment);
            }

            async function loadBookings() {
                if (isLoadingBookings) {
                    return;
                }

                isLoadingBookings = true;
                previousPageButton.disabled = true;
                nextPageButton.disabled = true;

                try {
                    const params = new URLSearchParams({
                        page: currentPage,
                        limit: pageLimit
                    });

                    const filters = new FormData(bookingFilters);

                    for (const field of ['q', 'ticketClass', 'tripId']) {
                        const value = String(filters.get(field) || '').trim();

                        if (value) {
                            params.set(field, value);
                        }
                    }

                    const response = await fetch(
                        `/api/bookings?${params.toString()}`
                    );

                    if (!response.ok) {
                        throw new Error('Failed to load bookings.');
                    }

                    const result = await response.json();
                    const bookings = result.data || [];
                    const pagination = result.pagination;

                    currentPage = pagination.page;
                    totalPages = pagination.totalPages;

                    // Keep the requested page valid after the final booking is deleted.
                    if (currentPage > Math.max(totalPages, 1)) {
                        currentPage = Math.max(totalPages, 1);
                        isLoadingBookings = false;
                        return loadBookings();
                    }

                    bookingsById = new Map(bookings.map((booking) => [booking.id, booking]));
                    renderBookings();

                    pageInfo.textContent = `Page ${currentPage} of ${Math.max(totalPages, 1)}`;
                    previousPageButton.disabled = !pagination.hasPreviousPage;
                    nextPageButton.disabled = !pagination.hasNextPage;
                } finally {
                    isLoadingBookings = false;
                    previousPageButton.disabled = currentPage <= 1;
                    nextPageButton.disabled = currentPage >= totalPages;
                }
            }

            function showEditor(card, booking) {
                const editor = editTemplate.content.cloneNode(true);
                const form = editor.querySelector('form');
                editor.querySelector('[data-field="edit-title"]').textContent =
                    `Editing Booking: ${booking.id}`;

                form.dataset.bookingId = booking.id;
                const ticketClassOptions = document.querySelector('#ticket-class-options');
                form.elements.ticketClass.replaceChildren(
                    ...Array.from(ticketClassOptions.options, (option) => option.cloneNode(true))
                );

                const scheduleOptions = document.querySelector(
                    `#schedule-day-options select[data-schedule-id="${booking.scheduleId}"]`
                );
                if (scheduleOptions) {
                    form.elements.selectedDay.replaceChildren(
                        ...Array.from(scheduleOptions.options, (option) => option.cloneNode(true))
                    );
                } else {
                    form.elements.selectedDay.disabled = true;
                }
                form.elements.ticketClass.value = booking.ticketClass;
                form.elements.selectedDay.value = booking.selectedDay;

                bookingsList.replaceChildren(editor);
                form.elements.ticketClass.focus();
            }

            async function saveBooking(event) {
                event.preventDefault();

                const form = event.target;
                const updates = Object.fromEntries(new FormData(form));

                const response = await fetch(
                    `/api/bookings/${form.dataset.bookingId}`,
                    {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(updates),
                    }
                );

                if (!response.ok) {
                    messageElement.textContent = 'The booking could not be updated.';
                    return;
                }

                messageElement.textContent = 'Booking updated.';
                await loadBookings();
            }

            async function deleteBooking(booking) {
                if (!window.confirm(`Delete booking ${booking.id}?`)) {
                    return;
                }

                const response = await fetch(
                    `/api/bookings/${booking.id}`,
                    { method: 'DELETE' }
                );

                if (!response.ok) {
                    messageElement.textContent = 'The booking could not be deleted.';
                    return;
                }

                messageElement.textContent = 'Booking deleted.';
                await loadBookings();
            }

            bookingsList.addEventListener('click', async (event) => {
                const button = event.target.closest('button[data-action]');

                if (!button) {
                    return;
                }

                const card = button.closest('[data-booking-id]');

                if (button.dataset.action === 'cancel') {
                    renderBookings();
                    return;
                }

                const booking = bookingsById.get(card.dataset.bookingId);

                if (button.dataset.action === 'edit') {
                    showEditor(card, booking);
                } else if (button.dataset.action === 'delete') {
                    await deleteBooking(booking);
                }
            });

            bookingsList.addEventListener('submit', async (event) => {
                if (event.target.matches('.booking-edit-form')) {
                    await saveBooking(event);
                }
            });

            bookingFilters.addEventListener('submit', async (event) => {
                event.preventDefault();
                currentPage = 1;
                messageElement.textContent = '';
                await loadBookings();
            });

            bookingFilters.addEventListener('reset', () => {
                currentPage = 1;
                messageElement.textContent = '';
                setTimeout(() => loadBookings(), 0);
            });

            previousPageButton.addEventListener('click', async () => {
                if (!isLoadingBookings && currentPage > 1) {
                    currentPage -= 1;
                    await loadBookings();
                }
            });

            nextPageButton.addEventListener('click', async () => {
                if (!isLoadingBookings && currentPage < totalPages) {
                    currentPage += 1;
                    await loadBookings();
                }
            });

            loadBookings()
                .then(() => {
                    loadingElement.hidden = true;
                })
                .catch((error) => {
                    loadingElement.hidden = true;
                    errorElement.hidden = false;
                    errorElement.textContent = error.message;
                });
        });
    </script>

    <%- include('./partials/footer') %>
