<%- include('../partials/header') %>

<article class="auth-page user-admin-page" data-current-user-id="<%= user.id %>" data-current-user-role="<%= user.role %>">
    <h1>User Management</h1>
    <p>View and manage user account information.</p>

    <p id="user-message" role="status" aria-live="polite"></p>

    <section aria-labelledby="users-heading">
        <h2 id="users-heading">Users</h2>

        <div id="users-loading">
            <p>Loading users...</p>
        </div>

        <div id="users-list">
            <!-- User accounts will be loaded here using JavaScript. -->
        </div>
    </section>
</article>

<script src="/js/users-admin.js"></script>

<%- include('../partials/footer') %>
